# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Pexels source photos/videos kept locally for re-processing — only the
# derived, optimized assets actually referenced in code (webp/mp4/webm under
# public/images/wanddurchbruch/) are versioned. ~130MB of unused raw source
# material stays out of git history.
public/images/wanddurchbruch/pexels-*.jpg
public/images/wanddurchbruch/*.mp4
!public/images/wanddurchbruch/wall-breakthrough-process.mp4
